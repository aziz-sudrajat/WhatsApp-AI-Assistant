# WhatsApp AI Assistant — environment configuration.
# Copy this file to ".env" and fill in the values you actually use:
#   cp .env.example .env
# NEVER commit your real .env file. NEVER share API keys in chat, issues,
# or screenshots.

# --- AI provider selection -------------------------------------------------
# One of: openai, anthropic, gemini, deepseek, groq, mistral, ollama, custom
AI_PROVIDER=openai

# Optional model override. Empty = the provider's default model
# (see README.md for the default per provider).
AI_MODEL=

# Optional system prompt override (default is built in).
SYSTEM_PROMPT=

# --- Provider API keys (only the one matching AI_PROVIDER is required) -----
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google (Gemini): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ollama (local): no key needed. Override the server URL only if Ollama
# does not run on this machine.
OLLAMA_BASE_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint: required when AI_PROVIDER=custom.
# Example: https://your-proxy.example.com/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# --- Reply behavior (optional; defaults are in config.example.json) --------
# Default reply mode for chats without a per-chat mode: auto | draft | off
DEFAULT_MODE=draft

# true = only private chats are answered, groups are ignored.
PRIVATE_ONLY=false

# true = in groups, only reply when the bot is mentioned.
MENTION_ONLY=false

# Comma-separated chat IDs that are allowed (empty = all allowed).
# Chat IDs look like: 1234567890@s.whatsapp.net (private) or 1234567890@g.us (group)
ALLOWLIST=

# Comma-separated chat IDs that are never answered.
BLOCKLIST=

# Minutes the AI stays paused in a chat after you reply from your phone.
TAKEOVER_COOLDOWN_MIN=30

# Maximum AI replies per chat per rolling minute (anti-ban hygiene).
MAX_REPLIES_PER_MIN=5

# Milliseconds of "typing..." simulation before each auto reply.
TYPING_DELAY_MS=1500

# How many recent messages per chat are kept as AI context.
HISTORY_LIMIT=20

# Milliseconds between draft-poll checks by the running gateway.
DRAFT_POLL_MS=5000
